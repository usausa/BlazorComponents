@page "/script-module"
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<PageTitle>ScriptModule</PageTitle>

<h1>ScriptModule</h1>

<p><code>js/example-module.js</code> is loaded on the first call.</p>

<div class="mb-4">
    <button class="btn btn-primary" @onclick="NowAsync">Get time</button>
    <span class="ms-2">@time</span>
</div>

<div class="input-group example-width">
    <input class="form-control" type="number" @bind="left" />
    <span class="input-group-text">+</span>
    <input class="form-control" type="number" @bind="right" />
    <button class="btn btn-primary" @onclick="AddAsync">=</button>
    <span class="input-group-text">@sum</span>
</div>

@code {
    private ScriptModule module = default!;

    private string time = string.Empty;

    private int left = 1;

    private int right = 2;

    private int? sum;

    protected override void OnInitialized()
    {
        module = new ScriptModule(JSRuntime, "./js/example-module.js");
    }

    private async Task NowAsync()
    {
        time = await module.InvokeAsync<string>("now");
    }

    private async Task AddAsync()
    {
        sum = await module.InvokeAsync<int>("add", left, right);
    }

    public ValueTask DisposeAsync() => module.DisposeAsync();
}
