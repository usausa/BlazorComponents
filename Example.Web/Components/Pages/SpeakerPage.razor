@page "/speaker"
@implements IDisposable
@inject ISpeaker Speaker

<PageTitle>Speaker</PageTitle>

<h1>Speaker</h1>

<div class="example-width">
    <p>
        <button class="btn btn-primary" @onclick="ChimeAsync">Chime</button>
    </p>

    <textarea class="form-control mb-3" rows="3" @bind="text"></textarea>

    <div class="row mb-2">
        <label class="col-3 col-form-label">Lang</label>
        <div class="col-9">
            <input class="form-control" @bind="lang" />
        </div>
    </div>
    <div class="row mb-2">
        <label class="col-3 col-form-label">Voice</label>
        <div class="col-9">
            <select class="form-select" @bind="voice">
                <option value="">(Default for Lang)</option>
                @foreach (var item in voices)
                {
                    <option value="@item.Name">@item.Name (@item.Lang@(item.LocalService ? string.Empty : ", remote"))</option>
                }
            </select>
        </div>
    </div>
    <div class="row mb-2">
        <label class="col-3 col-form-label">Rate @rate</label>
        <div class="col-9">
            <input class="form-range" type="range" min="0.5" max="2" step="0.1" @bind="rate" @bind:event="oninput" />
        </div>
    </div>
    <div class="row mb-2">
        <label class="col-3 col-form-label">Pitch @pitch</label>
        <div class="col-9">
            <input class="form-range" type="range" min="0" max="2" step="0.1" @bind="pitch" @bind:event="oninput" />
        </div>
    </div>
    <div class="row mb-3">
        <label class="col-3 col-form-label">Volume @volume</label>
        <div class="col-9">
            <input class="form-range" type="range" min="0" max="1" step="0.1" @bind="volume" @bind:event="oninput" />
        </div>
    </div>

    <button class="btn btn-primary" @onclick="SpeakAsync">Speak</button>
    <button class="btn btn-secondary" @onclick="CancelAsync">Cancel</button>

    <p class="mt-3">
        IsReady: @Speaker.IsReady<br />
        IsSpeaking: @Speaker.IsSpeaking<br />
        Result: @result
    </p>
</div>

@code {
    private IReadOnlyList<SpeechVoice> voices = [];

    private string text = "BlazorComponents の読み上げの例です。文ごとに区切って読み上げます。";

    private string lang = "ja-JP";

    private string voice = string.Empty;

    private double rate = 1;

    private double pitch = 1;

    private double volume = 1;

    private string result = string.Empty;

    protected override void OnInitialized()
    {
        Speaker.ReadyChanged += OnSpeakerChanged;
        Speaker.SpeakingChanged += OnSpeakerChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Speaker.PrepareAsync();
            voices = await Speaker.GetVoicesAsync();
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Speaker.ReadyChanged -= OnSpeakerChanged;
        Speaker.SpeakingChanged -= OnSpeakerChanged;
    }

    private async Task ChimeAsync()
    {
        result = string.Empty;
        result = await Speaker.PlayAsync(new Tone(880, 200), new Tone(1175, 200, 50)) ? "Played" : "Not played";
    }

    private async Task SpeakAsync()
    {
        result = string.Empty;
        var options = new SpeechOptions { Lang = lang, Voice = string.IsNullOrEmpty(voice) ? null : voice, Rate = rate, Pitch = pitch, Volume = volume };
        result = await Speaker.SpeakAsync(text, options) ? "Completed" : "Canceled";
    }

    private Task CancelAsync() => Speaker.CancelAsync().AsTask();

    private void OnSpeakerChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(StateHasChanged);
}
