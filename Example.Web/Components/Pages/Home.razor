@page "/"

<PageTitle>Home</PageTitle>

<h1>BlazorComponents</h1>

<p>Select a feature from the menu.</p>

<table class="table">
    <thead>
        <tr>
            <th>Feature</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><NavLink href="script-helper">Script helper</NavLink></td>
            <td>Focus an element, save or open bytes as a file, and move through the history</td>
        </tr>
        <tr>
            <td><NavLink href="script-module">ScriptModule</NavLink></td>
            <td>Load a JavaScript module on the first call</td>
        </tr>
        <tr>
            <td><NavLink href="media-query">MediaQuery</NavLink></td>
            <td>Bind the result of a CSS media query</td>
        </tr>
        <tr>
            <td><NavLink href="hot-key">HotKey</NavLink></td>
            <td>Call a method on a keyboard shortcut</td>
        </tr>
        <tr>
            <td><NavLink href="native-dialog">NativeDialog</NavLink></td>
            <td>Open and close a native <code>&lt;dialog&gt;</code> by binding</td>
        </tr>
        <tr>
            <td><NavLink href="speech-synthesizer">SpeechSynthesizer</NavLink></td>
            <td>Read text aloud with the browser's speech synthesis</td>
        </tr>
        <tr>
            <td><NavLink href="file-drop-zone">FileDropZone</NavLink></td>
            <td>Pass dropped or pasted files to the <code>&lt;InputFile&gt;</code> inside it</td>
        </tr>
        <tr>
            <td><NavLink href="file-upload">FileUpload</NavLink></td>
            <td>Upload dropped, pasted or picked files and folders to a URL from the browser</td>
        </tr>
    </tbody>
</table>
